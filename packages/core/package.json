{
  "name": "@diagrid/agent-core",
  "version": "0.1.1",
  "description": "Shared Dapr Workflow runtime for Diagrid AI agent framework adapters",
  "keywords": [
    "dapr",
    "workflow",
    "durable",
    "ai",
    "agents",
    "diagrid"
  ],
  "homepage": "https://github.com/diagridio/typescript-ai#readme",
  "bugs": "https://github.com/diagridio/typescript-ai/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagridio/typescript-ai.git",
    "directory": "packages/core"
  },
  "license": "BUSL-1.1",
  "author": "Diagrid Inc.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express.d.ts"
      ],
      "fastify": [
        "./dist/fastify.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@dapr/dapr": "3.18.0",
    "@grpc/grpc-js": "1.14.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "fastify-plugin": "6.0.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "express": "5.2.1",
    "fastify": "5.12.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
