{
  // The examples are type-checked by the workspace `tsc --build`, which is the
  // point of making them a workspace member: they consume the package's public
  // API the way a user does, so the build breaks the moment that API drifts.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../.tsbuild/example-identity",
    "tsBuildInfoFile": "../../.tsbuild/example-identity.tsbuildinfo"
  },
  "include": ["*.ts"],
  "references": [{ "path": "../../packages/core" }]
}
